NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_I71Llp-x08SnYEk4_jU4UA_PAHLciMt
# Chave secreta (service_role). Só no servidor: nunca com prefixo NEXT_PUBLIC_.
